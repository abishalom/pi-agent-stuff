{
  "name": "pi-agent-stuff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Pi package with utility extensions, Herdr-native interactive subagents, reusable skills, and prompts.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./pi-extension/notify-finished/index.ts",
      "./pi-extension/session-changed-files/index.ts",
      "./pi-extension/prompt-stash/index.ts",
      "./pi-extension/answer/index.ts",
      "./pi-extension/mitsupi/todos.ts",
      "./pi-extension/mitsupi/files.ts",
      "./pi-extension/herdr-subagents/index.ts",
      "./pi-extension/diff-review/index.ts",
      "./pi-extension/history-recall/index.ts"
    ],
    "skills": [
      "./skills",
      "./skills/uv/SKILL.md"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "scripts": {
    "test": "node --test",
    "build:diff-review-web": "node ./pi-extension/diff-review/web/build-static.mjs",
    "verify:diff-review-web": "node ./pi-extension/diff-review/web/verify-static.mjs"
  },
  "dependencies": {
    "@pierre/diffs": "^1.1.22",
    "@pierre/trees": "^1.0.0-beta.3",
    "glimpseui": "^0.6.2",
    "minisearch": "^7.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typebox": "^1.3.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.81.1",
    "@earendil-works/pi-coding-agent": ">=0.81.1",
    "@earendil-works/pi-tui": ">=0.81.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.81.1",
    "@earendil-works/pi-coding-agent": "^0.81.1",
    "@earendil-works/pi-tui": "^0.81.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  }
}
