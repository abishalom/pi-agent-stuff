{
  "name": "pi-agent-stuff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Pi package with utility extensions, Herdr-native interactive subagents, reusable skills, and prompts.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./pi-extension/notify-finished/index.ts",
      "./pi-extension/session-changed-files/index.ts",
      "./pi-extension/prompt-stash/index.ts",
      "./pi-extension/answer/index.ts",
      "./pi-extension/mitsupi/todos.ts",
      "./pi-extension/mitsupi/files.ts",
      "./pi-extension/herdr-subagents/index.ts",
      "./pi-extension/history-recall/index.ts",
      "./pi-extension/leaf-preview/index.ts"
    ],
    "skills": [
      "./skills",
      "./skills/uv/SKILL.md"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/node": "^22.20.5",
    "typebox": "^1.3.27",
    "typescript": "^6.0.3"
  }
}
